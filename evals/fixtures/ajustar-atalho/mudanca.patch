diff --git a/tests/Feature/EstornoTest.php b/tests/Feature/EstornoTest.php
new file mode 100644
index 0000000..3a96d76
--- /dev/null
+++ b/tests/Feature/EstornoTest.php
@@ -0,0 +1,32 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Enums\StatusPedido;
+use App\Livewire\Pedidos\Lista;
+use App\Models\Cliente;
+use App\Models\Pedido;
+use App\Models\User;
+use Livewire\Livewire;
+
+it('o Gerente estorna o Pedido aprovado e o Saldo volta', function (): void {
+    $cliente = Cliente::factory()->create(['saldo_centavos' => 1_000]);
+    $pedido = Pedido::factory()->for($cliente)->aprovado()->create(['total_centavos' => 2_500]);
+
+    Livewire::actingAs(User::factory()->gerente()->create())
+        ->test(Lista::class)
+        ->call('estornar', $pedido->id);
+
+    expect($pedido->fresh()->status)->toBe(StatusPedido::Cancelado)
+        ->and($cliente->fresh()->saldo_centavos)->toBe(3_500);
+});
+
+it('o Cliente não estorna', function (): void {
+    $cliente = Cliente::factory()->create();
+    $pedido = Pedido::factory()->for($cliente)->aprovado()->create();
+
+    Livewire::actingAs($cliente->user)
+        ->test(Lista::class)
+        ->call('estornar', $pedido->id)
+        ->assertForbidden();
+});
