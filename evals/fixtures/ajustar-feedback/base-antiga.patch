diff --git a/tests/Feature/SaldoClienteTest.php b/tests/Feature/SaldoClienteTest.php
new file mode 100644
index 0000000..b46d5b2
--- /dev/null
+++ b/tests/Feature/SaldoClienteTest.php
@@ -0,0 +1,19 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Livewire\Clientes\Saldo;
+use App\Models\Cliente;
+use App\Models\Pedido;
+use Livewire\Livewire;
+
+it('mostra ao Cliente o Saldo e o total dos Pedidos aprovados', function (): void {
+    $cliente = Cliente::factory()->create(['saldo_centavos' => 10_000]);
+    Pedido::factory()->for($cliente)->aprovado()->create(['total_centavos' => 2_500]);
+    Pedido::factory()->for($cliente)->create(['total_centavos' => 900]);
+
+    Livewire::actingAs($cliente->user)
+        ->test(Saldo::class)
+        ->assertSee('Saldo: 100,00')
+        ->assertSee('Pedidos aprovados: 25,00');
+});
