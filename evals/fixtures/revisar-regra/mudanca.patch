diff --git a/tests/Feature/QuemAprovouTest.php b/tests/Feature/QuemAprovouTest.php
new file mode 100644
index 0000000..70606a1
--- /dev/null
+++ b/tests/Feature/QuemAprovouTest.php
@@ -0,0 +1,30 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Enums\StatusPedido;
+use App\Livewire\Pedidos\Lista;
+use App\Models\Pedido;
+use App\Models\User;
+use Livewire\Livewire;
+
+it('grava o Gerente de --gerente na aprovação', function (): void {
+    $gerente = User::factory()->gerente()->create();
+    $pedido = Pedido::factory()->create();
+
+    $this->artisan('pedidos:aprovar', ['pedido' => $pedido->id, '--gerente' => $gerente->id])
+        ->assertSuccessful();
+
+    expect($pedido->fresh())
+        ->status->toBe(StatusPedido::Aprovado)
+        ->aprovado_por->toBe($gerente->id);
+});
+
+it('mostra ao Gerente quem aprovou o Pedido', function (): void {
+    $gerente = User::factory()->gerente()->create(['name' => 'Ana Gerente']);
+    Pedido::factory()->aprovado()->create(['aprovado_por' => $gerente->id]);
+
+    Livewire::actingAs($gerente)
+        ->test(Lista::class)
+        ->assertSee('Ana Gerente');
+});
