+<?php
+
+declare(strict_types=1);
+
+namespace App\Actions;
+
+use App\Enums\StatusPedido;
+use App\Models\Pedido;
+use App\Models\User;
+use App\Notifications\PedidoAprovado;
+use Illuminate\Support\Facades\DB;
+
+final class AprovarPedido
+{
+    public function handle(Pedido $pedido, User $gerente): Pedido
+    {
+        DB::transaction(function () use ($pedido, $gerente): void {
+            $pedido->update([
+                'status' => StatusPedido::Aprovado,
+                'aprovado_em' => now(),
+                'aprovado_por' => $gerente->id,
+            ]);
+        });
+
+        $pedido->cliente->user->notify(new PedidoAprovado($pedido));
+
+        return $pedido;
+    }
+}
