diff --git a/tests/Feature/AprovarPedidoTest.php b/tests/Feature/AprovarPedidoTest.php
new file mode 100644
index 0000000..ac3f1b4
--- /dev/null
+++ b/tests/Feature/AprovarPedidoTest.php
@@ -0,0 +1,32 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Actions\AprovarPedido;
+use App\Enums\StatusPedido;
+use App\Livewire\Pedidos\Lista;
+use App\Models\Pedido;
+use App\Models\User;
+use Illuminate\Support\Facades\Notification;
+use Livewire\Livewire;
+
+it('aprova o pedido na Action', function (): void {
+    Notification::fake();
+    $gerente = User::factory()->create(['papel' => 'gerente']);
+    $pedido = Pedido::factory()->create(['status' => StatusPedido::Pendente]);
+
+    $resultado = app(AprovarPedido::class)->handle($pedido, $gerente);
+
+    expect($resultado)->not->toBeNull();
+});
+
+it('gerente aprova pela lista', function (): void {
+    Notification::fake();
+    $gerente = User::factory()->create(['papel' => 'gerente']);
+    $pedido = Pedido::factory()->create(['status' => StatusPedido::Pendente]);
+
+    Livewire::actingAs($gerente)
+        ->test(Lista::class)
+        ->call('aprovar', $pedido->id)
+        ->assertOk();
+});
