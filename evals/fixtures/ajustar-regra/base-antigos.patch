+<?php
+
+declare(strict_types=1);
+
+namespace App\Actions;
+
+use App\Models\Pedido;
+
+final class ExportarPedidos
+{
+    /**
+     * Uma linha por Pedido, no formato que o financeiro importa: `id;total;cliente`.
+     *
+     * @return list<string>
+     */
+    public function handle(): array
+    {
+        return Pedido::query()
+            ->orderBy('id')
+            ->get()
+            ->map(fn (Pedido $pedido): string => implode(';', [
+                $pedido->id,
+                $pedido->total_centavos,
+                $pedido->cliente->user_id,
+            ]))
+            ->all();
+    }
+}
