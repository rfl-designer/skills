@@ -0,0 +1,16 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Actions\ExportarPedidos;
+use App\Models\Pedido;
+
+it('exporta uma linha por Pedido', function (): void {
+    $primeiro = Pedido::factory()->create(['total_centavos' => 1_000]);
+    $segundo = Pedido::factory()->create(['total_centavos' => 2_000]);
+
+    expect(app(ExportarPedidos::class)->handle())->toBe([
+        "{$primeiro->id};1000;{$primeiro->cliente->user_id}",
+        "{$segundo->id};2000;{$segundo->cliente->user_id}",
+    ]);
+});
