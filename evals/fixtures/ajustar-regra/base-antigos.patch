+<?php
+
+declare(strict_types=1);
+
+namespace App\Actions;
+
+use App\Models\User;
+
+final class SaldosBaixos
+{
+    /**
+     * Os e-mails dos Clientes com Saldo abaixo do limite, para o aviso de recarga.
+     *
+     * @return list<string>
+     */
+    public function handle(int $limiteCentavos): array
+    {
+        return User::query()
+            ->where('papel', 'cliente')
+            ->orderBy('id')
+            ->get()
+            ->filter(fn (User $user): bool => $user->cliente->saldo_centavos < $limiteCentavos)
+            ->pluck('email')
+            ->values()
+            ->all();
+    }
+}
