+<?php
+
+declare(strict_types=1);
+
+namespace App\Console\Commands;
+
+use App\Models\Cliente;
+use Illuminate\Console\Command;
+
+final class ResumoClientes extends Command
+{
+    protected $signature = 'clientes:resumo';
+
+    protected $description = 'Lista o Saldo de cada Cliente. O suporte usa este comando no fim do mês.';
+
+    public function handle(): int
+    {
+        foreach (Cliente::query()->orderBy('id')->get() as $cliente) {
+            $this->line($cliente->user->name.': '.number_format($cliente->saldo_centavos / 100, 2, ',', '.'));
+        }
+
+        return self::SUCCESS;
+    }
+}
